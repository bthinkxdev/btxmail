# /etc/bthinkx/backup.env on the mail server (chmod 600)
MAILCOW_DIR=/opt/mailcow-dockerized
STAGING_DIR=/var/backups/mailcow
LOCAL_RETENTION_DAYS=3
REMOTE_RETENTION_DAYS=30
# Public key(s) only. Keep the matching private key OFF this server (password manager / offline).
AGE_RECIPIENTS_FILE=/etc/bthinkx/backup-recipients.txt
# Any rclone remote: Backblaze B2, Wasabi, S3, another server via SFTP…
RCLONE_REMOTE=b2:bthinkx-backups/mailcow
PORTAL_URL=https://portal.bthinkx.com
BACKUP_REPORT_TOKEN=CHANGE_ME_same_value_as_in_the_portal_env
THREADS=2
