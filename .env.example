# =============================================================================
# BThinkX Email Platform — application server configuration
# Copy to .env, fill every CHANGE_ME, keep the file mode 600 and out of git.
# Generate secrets with:   openssl rand -base64 48
# Fernet key with:         python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# =============================================================================

APP_VERSION=1.0.0

# ---- Public hostnames --------------------------------------------------------
PORTAL_HOSTNAME=portal.bthinkx.com
PORTAL_URL=https://portal.bthinkx.com
DJANGO_ALLOWED_HOSTS=portal.bthinkx.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.bthinkx.com
PLATFORM_NAME=BThinkX Mail

# ---- Django core -------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME_at_least_50_random_characters_____________________
FIELD_ENCRYPTION_KEY=CHANGE_ME_fernet_key
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Number of reverse proxies in front of Django (nginx = 1; nginx behind Cloudflare = 2)
NUM_PROXIES=1
# Break-glass Django admin (no 2FA). Leave empty to disable; if set, use an unguessable path.
ADMIN_URL=
ENFORCE_2FA=1

# First super admin (only used while no super admin exists). Remove the password after first login.
BOOTSTRAP_ADMIN_EMAIL=owner@bthinkx.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_temporary_password

# ---- Database / Redis (containers on the internal network) -------------------
POSTGRES_DB=bthinkx_mail
POSTGRES_USER=bthinkx
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ---- Mail server (Mailcow on SERVER 2) ---------------------------------------
MAIL_HOSTNAME=mail.bthinkx.com
MAIL_IPV4=203.0.113.10
MAIL_IPV6=
WEBMAIL_URL=https://mail.bthinkx.com/SOGo
MAILCOW_API_URL=https://mail.bthinkx.com
# Read-write API key from mailcow.conf (API_KEY). Mailcow must allow this server's IP (API_ALLOW_FROM).
MAILCOW_API_KEY=CHANGE_ME
MAILCOW_VERIFY_TLS=1
MAILCOW_TIMEOUT=20

# ---- DNS records shown to customers ------------------------------------------
SPF_RECORD=v=spf1 mx -all
DMARC_RECORD=v=DMARC1; p=quarantine; adkim=s; aspf=s; pct=100; rua=mailto:dmarc-reports@bthinkx.com
DKIM_SELECTOR=dkim
DKIM_KEY_SIZE=2048
DOMAIN_VERIFICATION_PREFIX=_bthinkx-verification
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Spamhaus refuses queries from public resolvers; point this at a local/unbound resolver for accurate results.
DNSBL_RESOLVERS=
DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net,b.barracudacentral.org,psbl.surriel.com

# ---- Abuse protection ---------------------------------------------------------
ABUSE_AUTO_SUSPEND=1
ABUSE_HOURLY_MULTIPLIER=3
ABUSE_SPAM_THRESHOLD=10
ABUSE_AUTH_FAILURE_THRESHOLD=20

# ---- Transactional e-mail for the portal itself (NOT the Mailcow IP) ----------
# Use a separate provider (Amazon SES, Postmark, Brevo…) so portal mail cannot hurt mailbox reputation.
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BThinkX Mail <no-reply@bthinkx.com>

# ---- Alerts -------------------------------------------------------------------
ALERT_EMAILS=ops@bthinkx.com
# Optional Slack/Teams/generic incoming webhook (JSON with a "text" field)
ALERT_WEBHOOK_URL=
DISK_ALERT_PERCENT=80
MAIL_QUEUE_ALERT=200

# ---- Backups ------------------------------------------------------------------
# Shared secret the mail-server backup job uses to report success/failure.
BACKUP_REPORT_TOKEN=CHANGE_ME
BACKUP_MAX_AGE_HOURS=26

# ---- Metrics ------------------------------------------------------------------
# Networks allowed to scrape /metrics directly on the backend container (never via nginx).
METRICS_ALLOWED_IPS=127.0.0.1,172.16.0.0/12

# ---- Tuning -------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
# Proxies trusted for X-Forwarded-* (default: any; the backend is only reachable from nginx).
GUNICORN_FORWARDED_ALLOW_IPS=*
CELERY_CONCURRENCY=4

# ---- App database backup (deploy/scripts/backup-app-db.sh) --------------------
DB_RCLONE_REMOTE=b2:bthinkx-backups/app-db
DB_RETENTION_DAYS=30
AGE_RECIPIENTS_FILE=/etc/bthinkx/backup-recipients.txt

# ---- Push notifications -------------------------------------------------------
# docker compose run --rm backend manage generate_vapid_keys   (keep the private key secret; never rotate casually)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bthinkx.com
# Shared secret the mail server uses for the new-mail hook: openssl rand -hex 32  (see deploy/mailcow/new-mail-hook)
NEW_MAIL_WEBHOOK_TOKEN=
PUSH_MAIL_RATE_PER_MINUTE=30
