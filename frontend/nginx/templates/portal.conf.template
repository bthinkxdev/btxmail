# Rendered by the nginx image's envsubst at start-up.
# ${PORTAL_HOSTNAME} — e.g. portal.bthinkx.com

upstream django {
    server ${BACKEND_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${PORTAL_HOSTNAME};

    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${PORTAL_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    root /usr/share/nginx/html;

    # Internal-only endpoints are never exposed publicly.
    location = /metrics { return 404; }
    location = /readyz  { return 404; }

    location = /api/auth/login/      { limit_req zone=auth burst=5 nodelay; include /etc/nginx/conf.d/proxy.inc; }
    location = /api/auth/login/otp/  { limit_req zone=auth burst=5 nodelay; include /etc/nginx/conf.d/proxy.inc; }
    location /api/auth/password/     { limit_req zone=auth burst=5 nodelay; include /etc/nginx/conf.d/proxy.inc; }

    location /api/          { limit_req zone=api burst=40 nodelay; include /etc/nginx/conf.d/proxy.inc; }
    location = /healthz     { include /etc/nginx/conf.d/proxy.inc; }
    location /django-static/ {
        include /etc/nginx/conf.d/proxy.inc;
        expires 30d;
    }
    location /${ADMIN_PATH} { include /etc/nginx/conf.d/proxy.inc; }

    # Hashed build assets are immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which must never be cached.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    }
}
